# ─────────────────────────────────────────────────────────────
# CongoConnect — environment configuration
# Copy to `.env.local` and fill in real values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME=CongoConnect
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database (Prisma). Use a SQLite file locally or Postgres/MySQL in production.
DATABASE_URL="file:./prisma/dev.db"

# Session signing secret — REQUIRED in production. Use a long random string.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Rate limiting (requests per minute per IP). Uses in-memory sliding window by
# default; set the Upstash vars below to use a shared store across instances.
RATE_LIMIT_PER_MIN=120
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# CORS — comma-separated allowlist. Use '*' to allow any origin (no credentials).
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# CSRF — double-submit token endpoint at /api/csrf (SameSite=Lax cookie + header).
# No extra config needed; ensure SESSION_SECRET is set in production.

# Supabase (optional — only if used)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment providers (optional). When unset, that method returns 501 "not
# configured" instead of silently succeeding. Add real keys to enable each rail.
# M-Pesa (Safaricom Daraja): MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET, MPESA_SHORTCODE, MPESA_PASSKEY
# Airtel Money: AIRTEL_CLIENT_ID, AIRTEL_CLIENT_SECRET
# Orange Money: ORANGE_CLIENT_ID, ORANGE_CLIENT_SECRET
# Card (Stripe or Paystack): STRIPE_SECRET_KEY  |  PAYSTACK_SECRET_KEY, PAYSTACK_PUBLIC_KEY
# Bank transfer is offline (pending) and needs no keys.

# Flight search API (Amadeus Self-Service)
# Get keys at https://developers.amadeus.com/my-apps
# Start with hostname=test (sandbox, free). Switch to production for live bookings.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# AMADEUS_HOSTNAME=test

# Notifications / delivery (optional). Unset => channel returns "not_configured".
# SMS:   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN  |  AT_USERNAME, AT_API_KEY (Africa's Talking)
# Push:  VAPID_PRIVATE_KEY, VAPID_PUBLIC_KEY (Web Push)
# Real-time: in-process SSE by default; for multi-instance use Redis pub/sub.
